              "pm.test(\"Status code adalah 200 (Success GET by ID)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Data yang dikembalikan sesuai dengan ID yang tersimpan\", function () {\r\n    var jsonData = pm.response.json();\r\n    \r\n    // Menyesuaikan struktur JSON respons backend (misal: jsonData.id atau jsonData.data.id)\r\n    var returnedId = jsonData.id || (jsonData.data ? jsonData.data.id : null);\r\n    var savedId = pm.environment.get(\"menu_id\");\r\n    \r\n    if (returnedId) {\r\n        pm.expect(String(returnedId)).to.eql(String(savedId));\r\n    }\r\n});"
            ]
