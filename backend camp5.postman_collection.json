            "exec": [
              "pm.test(\"Status code adalah 201 atau 200 (Created/Success)\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r\n});\r\n\r\n// Menyimpan ID otomatis ke environment variable 'menu_id'\r\nvar jsonData = pm.response.json();\r\n// Sesuaikan path 'jsonData.id' dengan struktur JSON dari backend Anda\r\nif (jsonData.id) {\r\n    pm.environment.set(\"menu_id\", jsonData.id);\r\n    console.log(\"ID Menu tersimpan: \" + jsonData.id);\r\n} else if (jsonData.data && jsonData.data.id) {\r\n    pm.environment.set(\"menu_id\", jsonData.data.id);\r\n    console.log(\"ID Menu tersimpan: \" + jsonData.data.id);\r\n}"
            ]
          }
        }
      ],
