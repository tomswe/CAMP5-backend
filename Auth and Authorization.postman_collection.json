            "exec": [
              "pm.test(\"Get current user\", () => {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\nconst res = pm.response.json();\r\n\r\npm.expect(res).to.have.property(\"id\");\r\npm.expect(res).to.have.property(\"email\");\r\npm.expect(res).to.have.property(\"role\");\r\n\r\n// sync env\r\npm.environment.set(\"user_id\", res.id);\r\npm.environment.set(\"user_email\", res.email);\r\npm.environment.set(\"user_role\", res.role);"
