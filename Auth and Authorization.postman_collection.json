      "name": "Signup",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Signup success\", () => {\r\n  pm.response.to.have.status(201);\r\n});\r\n\r\nconst res = pm.response.json();\r\n\r\n// save user\r\npm.environment.set(\"user_id\", res.user.id);\r\npm.environment.set(\"user_email\", res.user.email);\r\npm.environment.set(\"user_role\", res.user.role);\r\n\r\n// save cookies (fallback manual)\r\nconst cookies = pm.cookies.toObject();\r\n\r\nif (cookies.access_token) {\r\n  pm.environment.set(\"access_token\", cookies.access_token);\r\n}\r\n\r\nif (cookies.refresh_token) {\r\n  pm.environment.set(\"refresh_token\", cookies.refresh_token);\r\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
